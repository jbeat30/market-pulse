# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Supabase는 풀링(6543)과 다이렉트(5432) 연결을 분리해서 사용
DATABASE_URL=
DIRECT_URL=

# 네이버 검색 오픈 API(developers.naver.com) — 쇼핑 검색(shop.json) 전용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# NextAuth(Auth.js) 세션 암호화 시크릿 — openssl rand -base64 32
AUTH_SECRET=

# 최고관리자 시드 비밀번호(prisma/seed.ts 전용)
SEED_SUPER_ADMIN_PASSWORD=

# Web Push(추후 필요 시 추가)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
